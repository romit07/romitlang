{
  "name": "romit",
  "displayName": "Romit",
  "description": "Syntax highlighting, errors as you type, autocomplete, snippets, and run/preview for the Romit language (.rmt): write apps the way you write prompts.",
  "version": "0.2.0",
  "publisher": "romitlang",
  "license": "MIT",
  "icon": "images/icon.png",
  "homepage": "https://romitlang.org/",
  "repository": {
    "type": "git",
    "url": "https://github.com/romit07/romitlang.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/romit07/romitlang/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "romit",
    "rmt",
    "ui",
    "swiftui",
    "no-code",
    "vibe coding"
  ],
  "contributes": {
    "languages": [
      {
        "id": "romit",
        "aliases": [
          "Romit",
          "romit"
        ],
        "extensions": [
          ".rmt"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-icon.svg",
          "dark": "./images/file-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "romit",
        "scopeName": "source.romit",
        "path": "./syntaxes/romit.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "romit",
        "path": "./snippets/romit.code-snippets"
      }
    ],
    "configurationDefaults": {
      "[romit]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.autoIndent": "keep",
        "editor.wordBasedSuggestions": "currentDocument",
        "files.trimTrailingWhitespace": true
      }
    },
    "configuration": {
      "title": "Romit",
      "properties": {
        "romit.path": {
          "type": "string",
          "default": "romit",
          "description": "Path to the `romit` program used to check and run files."
        },
        "romit.checkOnType": {
          "type": "boolean",
          "default": true,
          "description": "Check Romit files as you type (otherwise only when you open or save them)."
        }
      }
    },
    "commands": [
      {
        "command": "romit.run",
        "title": "Romit: Run or preview this file",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "romit.run",
          "when": "resourceLangId == romit"
        }
      ]
    },
    "keybindings": [
      {
        "command": "romit.run",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorLangId == romit"
      }
    ]
  },
  "scripts": {
    "build-grammar": "python3 scripts/build_grammar.py",
    "test": "node test/grammar.test.js && node test/extension.test.js",
    "package": "npx --yes @vscode/vsce@3 package --no-dependencies"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:romit"
  ]
}
