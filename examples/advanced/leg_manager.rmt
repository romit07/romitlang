spec SeatRenewal version 1
about "Renew each seat before expiry and close over-limit seats, one renewal at a time."

enum Plan basic premium
enum Status active renewing closed

config
  usage_limit_pct int is 30
  renew_within int is 3
  max_active int is 4

entity Seat keyed by id
  id text
  plan Plan
  quota int above 0
  used int at least 0
  days_left int at least 0
  status Status is active

event Tick with seat Seat used int days_left int stores used days_left
event RenewDone with seat Seat

output CloseSeat
  seat text
  reason text

output RenewSeat
  seat text

define over_by seat Seat returns int
  seat.used minus seat.quota

machine Seat.status
  active to renewing or closed
  renewing to active or closed
  closed to final

on Tick with seat
  rule usage_limit
    when seat.status is active
    set seat.status to closed
    emit CloseSeat with seat seat.id reason "usage_limit"

invariant active_cap
  count Seat where status is not closed below max_active

limit CloseSeat at most 1 per seat

test usage_limit_simple
  given Seat id "A" plan basic quota 100 used 90 days_left 5
  send Tick with seat "A" used 65 days_left 2
  expect Seat at "A" status is closed
  expect emitted CloseSeat with seat "A" reason "usage_limit"
